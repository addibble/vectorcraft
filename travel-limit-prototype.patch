+/// Prototype: the distance from `p` along `p`→`q` to the first edge of `region` it crosses, not
+/// counting the edges that touch `p`. Every edge is tested: O(points × edges).
+fn first_hit(region: &[&[Point]], p: Point, q: Point) -> Option<f64> {
+    let (dx, dy) = (q.x - p.x, q.y - p.y);
+    let len = dx.hypot(dy);
+    if len < 1e-12 {
+        return None;
+    }
+    let mut best: Option<f64> = None;
+    for ring in region {
+        let n = ring.len();
+        for k in 0..n {
+            let (a, b) = (ring[k], ring[(k + 1) % n]);
+            if a.distance(p) < 1e-9 || b.distance(p) < 1e-9 {
+                continue;
+            }
+            let (ex, ey) = (b.x - a.x, b.y - a.y);
+            let den = dx * ey - dy * ex;
+            if den.abs() < 1e-15 {
+                continue;
+            }
+            let (fx, fy) = (a.x - p.x, a.y - p.y);
+            let t = (fx * ey - fy * ex) / den;
+            let u = (fx * dy - fy * dx) / den;
+            if (1e-9..=1.0).contains(&t) && (0.0..=1.0).contains(&u) {
+                let d = t * len;
+                best = Some(best.map_or(d, |b: f64| b.min(d)));
+            }
+        }
+    }
+    best
+}
